+import os from 'node:os';
+
+// Isolated fixtures only: never attach to a user's browser or contact production.
+const root = process.cwd(), localRequire = createRequire(path.join(root, 'package.json'));
+const entry = `
+import {useEffect,useRef,useState} from 'react';
