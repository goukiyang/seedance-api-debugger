+import './src/app/globals.css';
+const images=['a','b','c','bad','slow'].map(id=>({src:'/fixture/'+id+'.png',alt:'生成结果 '+id,pickerKey:'asset:'+id,contentKey:'asset:'+id}));
+function Preview(){const [open,setOpen]=useState(true),[index,setIndex]=useState(0);return <><button onClick={()=>setOpen(true)}>打开大图</button>{open&&<ZoomableImagePreview src={images[index].src} alt='生成结果' previewKey='fixture-root' comparisonCandidates={images} hasNavigation onPrevious={()=>setIndex(value=>(value+2)%3)} onNext={()=>setIndex(value=>(value+1)%3)} onClose={()=>setOpen(false)}/>}</>}
+function Paste(){const [value,setValue]=useState('旧正文'),[disabled,setDisabled]=useState(false),[visible,setVisible]=useState(true),[changes,setChanges]=useState(0);const ref=useRef(null);return <main><button onClick={()=>setDisabled(value=>!value)}>切换权限</button><button onClick={()=>setVisible(value=>!value)}>切换挂载</button><output data-testid='changes'>{changes}</output>{visible&&<><ContextClipboardActions value={value} textareaRef={ref} maxLength={12} disabled={disabled} onPaste={text=>{setValue(text);setChanges(value=>value+1)}}/><textarea aria-label='正文' ref={ref} value={value} onChange={event=>setValue(event.target.value)}/></>}</main>}
+function Batch(){const [draft,setDraft]=useState('fixture'),[owner,setOwner]=useState('fixture-admin');const batch=useStudioBatch({userId:owner,moduleId:'fixture-module',unitCredits:8,draftSignature:draft});return <main><button onClick={()=>batch.setMode('batch')}>批量模式</button><button onClick={()=>setDraft(value=>value+'x')}>修改正文</button><button onClick={()=>setOwner('other-fixture')}>切换账号</button>{batch.mode==='batch'&&batch.controls}<button aria-label='准备生成' disabled={!!batch.blocker||batch.busy} onClick={()=>void batch.submit({model:'gemini-2.5-flash-image',quality:'standard',resolution:'1K',aspectRatio:'1:1',revision:1,prompt:draft,moduleId:'fixture-module'})}>准备生成</button><output data-testid='batch-state'>{JSON.stringify({id:batch.id,pending:batch.pending,blocker:batch.blocker})}</output></main>}
+function Ratio(){const[value,setValue]=useState('1:1');return <main style={{padding:24,width:280}}><RatioPicker value={value} onChange={setValue} model='gemini-2.5-flash-image' resolution='1K' custom={[]} busy={false} disabled={false} error='' onRetry={()=>{}} onCustom={async()=>true} onEditing={()=>{}} fourToOneSupported={true}/></main>}
+function Navigation(){const target=useRef(null),layout=useRef(null);return <><div className='composer-topbar' style={{position:'fixed',top:0,left:0,width:'100%',height:70,zIndex:2,background:'#bbb'}}>示例导航</div><main ref={layout}><button style={{position:'fixed',top:4,right:4,zIndex:3}} onClick={()=>scrollToWorkbenchHeader(target.current,layout.current,'auto',()=>{window.navSettled=true})}>定位模块</button><div id='preceding' style={{height:1400}}/><header ref={target} data-testid='module-header' style={{height:60}}>当前模块标题</header><div style={{height:1400}}/></main></>}
+function Boot(){const{refreshUser}=useAppSession();useEffect(()=>{history.replaceState({},'');void refreshUser()},[refreshUser]);const route=location.pathname;return route==='/paste'?<Paste/>:route==='/batch'?<Batch/>:route==='/ratio'?<Ratio/>:route==='/navigation'?<Navigation/>:route==='/cutout'?<CutoutPage/>:route==='/results'?<BatchResults userId='fixture-admin' id={'a'.repeat(64)} deliveryOnly={location.search==='?delivery=1'}/>:<Preview/>}
+createRoot(document.getElementById('root')).render(<AppSessionProvider><Boot/></AppSessionProvider>);
+`;
+
+async function main() {
+  const failures: string[] = [], passed: string[] = [], errors: string[] = [], external: string[] = [];
+  const requests: Array<{ path: string; method: string; key?: string; body?: any }> = [];
+  let browser: any, server: http.Server | undefined, fixtureDirectory: string | undefined;
+  const run = async (label: string, action: () => Promise<void>) => { if (process.env.FOLLOWUPS_CASE && !label.startsWith(process.env.FOLLOWUPS_CASE)) return; try { await action(); passed.push(label); } catch (error) { failures.push(`${label}: ${error instanceof Error ? error.message : error}`); } };
