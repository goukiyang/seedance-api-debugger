+export function adaptAvatarPrompt(candidate: AvatarCandidate, model: string): AvatarCandidate {
+  const instruction = model.startsWith('gemini-') ? '生成一张符合以下人物描述的图片。参考图仅用于明确要求保持的身份。' : '写实人物摄影。严格遵循以下人物属性、人数、位置与参考图身份约束。';
