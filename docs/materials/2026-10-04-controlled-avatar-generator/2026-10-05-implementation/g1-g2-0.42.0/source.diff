+export function avatarPlanKey(owner: string, plan: Pick<AvatarPlan, 'id' | 'layout'>) { return avatarKey(owner, avatarLayout(plan)==='contact-sheet'||plan.id.startsWith('sheet-')?'sheet-plan':'plan',plan.id); }
+export function avatarRecordKey(owner: string, record: Pick<AvatarRecord, 'id' | 'layout' | 'rules'>) { return avatarKey(owner,record.id.startsWith('sheet-')||record.layout==='contact-sheet'||record.rules?.layout==='contact-sheet'?'sheet-record':'record',record.id); }
+export function avatarReadKeys(owner: string, kind: string, id: string) {
+  return kind==='plan'||kind==='record' ? [avatarKey(owner,`sheet-${kind}`,id),avatarKey(owner,kind,id)] : [avatarKey(owner,kind,id)];
+}
