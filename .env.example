# Database
DATABASE_URL="file:./dev.db"

# Provider Configuration
PROVIDER=jimeng
MODEL=jimeng-video-v2
BASE_URL=https://jimeng.jianying.com

# ============================================================================
# App Configuration
# ============================================================================

# Base URL (公网域名，生产环境需配置为实际公网地址)
# 本地开发：留空则默认 http://localhost:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 飞书登录（复用现有飞书机器人应用）
# FEISHU_LOGIN_ENABLED=false
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_REDIRECT_URI=https://your-domain.com/api/auth/feishu/callback
# FEISHU_SCOPE=auth:user.id:read user_profile
# FEISHU_AUTO_CREATE_USER=false
# FEISHU_ALLOWED_TENANT_KEY=xxx
# FEISHU_ALLOWED_DEPARTMENT_IDS=od_xxx,od_yyy
# 本地开发兜底：未配置 OAuth 密钥时，允许使用已登录的 lark-cli 登录本站
# FEISHU_CLI_LOGIN_ENABLED=true
# FEISHU_CLI_AUTO_CREATE_USER=true

# ============================================================================
# Storage Configuration (公网对象存储)
# ============================================================================
# 当前阶段优先使用 Cloudflare R2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET=seedance-assets
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# 备选方案：火山引擎 TOS
# TOS_REGION=ap-southeast-1
# TOS_BUCKET=your-bucket
# TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# TOS_ACCESS_KEY=your-access-key
# TOS_SECRET_KEY=your-secret-key
# TOS_PUBLIC_BASE_URL=https://your-bucket.your-domain.com
