# Database
DATABASE_URL="file:./dev.db"

# Provider Configuration
PROVIDER=jimeng
MODEL=jimeng-video-v2
BASE_URL=https://jimeng.jianying.com

# ============================================================================
# App Configuration
# ============================================================================

# Base URL (公网域名，生产环境需配置为实际公网地址)
# 本地开发：留空则默认 http://localhost:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ============================================================================
# Storage Configuration (公网对象存储)
# ============================================================================
# 优先方案 A：火山引擎 TOS（推荐，与 Seedance 同体系）
# TOS_REGION=ap-southeast-1
# TOS_BUCKET=your-bucket
# TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# TOS_ACCESS_KEY=your-access-key
# TOS_SECRET_KEY=your-secret-key
# TOS_PUBLIC_BASE_URL=https://your-bucket.your-domain.com

# 备选方案 B：Cloudflare R2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET=your-bucket
# R2_PUBLIC_BASE_URL=https://your-domain.com/assets
