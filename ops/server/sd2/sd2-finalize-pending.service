[Unit]
Description=sd2 finalize pending video tasks
After=network.target sd2-gray.service

[Service]
Type=oneshot
User=gouki
Group=gouki
# Render this template for the exact candidate release; never install it verbatim.
WorkingDirectory=@RELEASE_ROOT@
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run video:finalize-pending -- --limit 20 --max-seconds 900 --missing-local-limit 2
TimeoutStartSec=1200
StandardOutput=append:/var/log/video-api-debugger/sd2-finalize-pending.log
StandardError=append:/var/log/video-api-debugger/sd2-finalize-pending.log
