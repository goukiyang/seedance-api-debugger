// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model VideoTask {
  id                   String  @id @default(cuid())
  provider             String
  model                String
  generation_mode      String
  prompt               String
  source_type          String  @default("web") // web | codex_api
  source_label         String?
  source_request_id    String?
  source_metadata_json String?

  ratio             String?
  duration          Int?
  resolution        String?
  seed              Int?
  generate_audio    Boolean @default(true)
  return_last_frame Boolean @default(false)
  watermark         Boolean @default(false)

  reference_image_urls String?
  reference_video_urls String?
  reference_audio_urls String?
  first_frame_url      String?
  last_frame_url       String?
  frame_image_urls     String?

  callback_url            String?
  execution_expires_after Int?

  local_status          String  @default("draft")
  provider_task_id      String?
  provider_status       String?
  result_video_url      String?
  result_last_frame_url String?
  local_video_path      String?
  public_video_url      String?
  public_video_storage_provider String?
  public_video_storage_key      String?
  public_video_file_size        Int?
  public_video_cached_at        DateTime?

  raw_create_response   String?
  raw_status_response   String?
  error_message         String?
  error_code            String?
  reference_album_ids   String?
  reference_image_ids   String?
  params_json           String?
  reference_images_json String?
  provider_payload_json String?

  // 关联 workspace 和快照
  workspace_id String?
  snapshot_id  String? @unique

  // 用户关联（P0-B）
  user_id         String?
  owner_user_id   String?
  project_id      String?
  video_card_id   String?
  video_branch_id String?
  template_id     String?
  agent_run_id    String?
  visibility      String  @default("project") // private | project | selected | public
  version_role    String  @default("normal") // normal | candidate | current_best | final | discarded
  selected_agent_plan_key String?
  agent_prompt_snapshot   String?
  final_prompt_snapshot   String?
  prompt_user_edited      Boolean @default(false)

  // 产出留存与用户删除（管理员仍可审计）
  retention_status String    @default("active") // active | user_deleted | admin_hidden | retained
  user_deleted_at  DateTime?
  user_deleted_by  String?
  admin_hidden_at  DateTime?
  admin_hidden_by  String?
  restored_at      DateTime?
  restored_by      String?
  delete_reason    String?

  // 点数与计费（P0-B）
  estimated_cost         Float?
  actual_cost            Float?
  frozen_cost            Float?
  refund_amount          Float?
  credit_freeze_snapshot String?
  pricing_snapshot       String?
  pricing_rule_id        String?
  idempotency_key        String?
  billing_scope          String  @default("user") // user | project | system
  billing_account_id     String?

  // 外部成本复盘（真实官方扣费接入前先保存状态与快照，不把点数当现金成本）
  provider_cost_status            String    @default("not_recorded") // not_recorded | estimated_by_rule | provisional_settled | official_confirmed | reconciled | disputed | unknown
  provider_cost_snapshot          String?
  provider_cost_currency          String?
  provider_estimated_amount_minor Int?
  provider_rule_amount_minor      Int?
  provider_official_amount_minor  Int?
  provider_final_amount_minor     Int?
  provider_official_amount_micros Int?
  provider_final_amount_micros    Int?
  provider_billing_status         String?
  provider_billing_time           DateTime?
  provider_usage_snapshot         String?
  provider_client_request_id      String?
  provider_cost_confirmed_at      DateTime?
  provider_cost_reconciled_at     DateTime?
  cost_allocation_status          String    @default("allocated") // allocated | unallocated | partially_allocated

  workspace              Workspace?           @relation(fields: [workspace_id], references: [id])
  user                   User?                @relation("VideoTaskUser", fields: [user_id], references: [id])
  owner                  User?                @relation("VideoTaskOwner", fields: [owner_user_id], references: [id])
  project                Project?             @relation(fields: [project_id], references: [id])
  video_card             VideoCard?           @relation("VideoCardTasks", fields: [video_card_id], references: [id], onDelete: SetNull)
  video_branch           VideoBranch?         @relation(fields: [video_branch_id], references: [id], onDelete: SetNull)
  generation_template   GenerationTemplate?  @relation(fields: [template_id], references: [id], onDelete: SetNull)
  current_best_for_cards VideoCard[]          @relation("VideoCardCurrentBest")
  final_for_cards        VideoCard[]          @relation("VideoCardFinal")
  provider_api_requests  ProviderApiRequest[]
  cost_ledgers           CostLedger[]
  cost_allocations       CostAllocation[]
  approval_records       ApprovalRecord[]
  approval_usages        ApprovalUsage[]

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  completed_at DateTime?

  @@unique([user_id, idempotency_key])
  @@index([user_id])
  @@index([owner_user_id])
  @@index([project_id])
  @@index([video_card_id])
  @@index([video_branch_id])
  @@index([template_id])
  @@index([agent_run_id])
  @@index([version_role])
  @@index([source_type])
  @@index([source_request_id])
  @@index([local_status])
  @@index([provider_task_id])
  @@index([public_video_storage_provider, public_video_storage_key])
  @@index([provider_client_request_id])
  @@index([provider_cost_status])
  @@index([retention_status])
  @@index([user_deleted_at])
}

// ============================================================================
// 用户与权限系统
// ============================================================================

model User {
  id                    String    @id @default(cuid())
  name                  String
  username              String    @unique
  email                 String    @unique
  password_hash         String
  role                  String    @default("user") // admin | user
  account_type          String    @default("internal") // internal | external
  status                String    @default("active") // active | disabled | pending | expired
  user_profile          String    @default("other") // core_video | core_animation | core_design | noncore_planning | noncore_ops | noncore_pm | other
  feature_profile_id    String?
  expires_at            DateTime?
  mobile                String?
  avatar_url            String?
  feishu_user_id        String?   @unique
  feishu_open_id        String?   @unique
  feishu_union_id       String?
  feishu_tenant_key     String?
  feishu_employee_no    String?
  feishu_department_ids String?
  feishu_raw_profile    String?
  last_feishu_sync_at   DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  last_login_at         DateTime?

  credit_account          CreditAccount?
  credit_ledger           CreditLedger[]
  credit_buckets          CreditBucket[]
  operation_logs          OperationLog[]
  tasks                   VideoTask[]          @relation("VideoTaskUser")
  owned_tasks             VideoTask[]          @relation("VideoTaskOwner")
  owned_video_cards       VideoCard[]          @relation("VideoCardOwner")
  created_video_cards     VideoCard[]          @relation("VideoCardCreator")
  sealed_video_cards      VideoCard[]          @relation("VideoCardSealer")
  reference_albums        ReferenceAlbum[]     @relation("ReferenceAlbumOwner")
  reference_images        ReferenceImage[]     @relation("ReferenceImageOwner")
  created_album_shares    AlbumShare[]         @relation("AlbumShareCreator")
  owned_projects          Project[]            @relation("ProjectOwner")
  created_projects        Project[]            @relation("ProjectCreator")
  canvas_documents        CanvasDocument[]     @relation("CanvasDocumentOwner")
  project_memberships     ProjectMember[]      @relation("ProjectMemberUser")
  joined_project_members  ProjectMember[]      @relation("ProjectMemberJoinedBy")
  created_project_invites ProjectInvite[]      @relation("ProjectInviteCreatedBy")
  provider_api_requests   ProviderApiRequest[]
  cost_ledgers            CostLedger[]
  cost_allocations        CostAllocation[]
  content_audit_actions   ContentAuditLog[]    @relation("ContentAuditActor")
  content_audit_owned     ContentAuditLog[]    @relation("ContentAuditOwner")
  approval_requests       ApprovalRecord[]     @relation("ApprovalRequester")
  approval_decisions      ApprovalRecord[]     @relation("ApprovalApprover")
  approval_usages         ApprovalUsage[]      @relation("ApprovalUsageUser")
  notification_targets    Notification[]       @relation("NotificationTarget")
  notification_actors     Notification[]       @relation("NotificationActor")
  generated_review_cards  ReviewCard[]         @relation("ReviewCardGenerator")
  feedbacks               Feedback[]
  preferences             UserPreference[]

  @@index([username])
  @@index([email])
  @@index([account_type])
  @@index([user_profile])
  @@index([status])
  @@index([feishu_union_id])
  @@index([feishu_tenant_key])
}

model PlatformSetting {
  id         String   @id @default(cuid())
  key        String   @unique
  value_json String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([key])
}

model GenerationTemplate {
  id                   String   @id @default(cuid())
  template_key         String   @unique
  name                 String
  description          String?
  status               String   @default("draft") // draft | active | archived
  version              String   @default("v1")
  module_bindings_json String   @default("{}")
  temporal_json        String   @default("{\"enabled\":true,\"segment\":15,\"handoff\":false}")
  default_ratio        String?
  default_duration     Int?
  default_resolution   String?
  created_by           String
  updated_by           String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  assets    TemplateAsset[]
  rules     TemplateRule[]
  prompts   TemplatePromptBlock[]
  agentRuns AgentRun[]
  memories  TemplateMemory[]
  tasks     VideoTask[]

  @@index([status])
  @@index([created_by])
  @@index([updated_at])
}

model TemplateAsset {
  id                 String   @id @default(cuid())
  template_id        String
  asset_type         String // character | logo | style | other
  label              String
  url                String?
  thumbnail_url      String?
  reference_image_id String?
  sort_order         Int      @default(0)
  status             String   @default("active") // active | archived
  metadata_json      String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  template GenerationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@index([asset_type])
  @@index([status])
}

model TemplateRule {
  id          String   @id @default(cuid())
  template_id String
  rule_type   String // must | forbid | suggest
  content     String
  priority    Int      @default(50)
  sort_order  Int      @default(0)
  status      String   @default("active") // active | disabled
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  template GenerationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@index([rule_type])
  @@index([status])
}

model TemplatePromptBlock {
  id          String   @id @default(cuid())
  template_id String
  block_type  String // character | logo | style | global
  content     String
  sort_order  Int      @default(0)
  status      String   @default("active") // active | disabled
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  template GenerationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@index([block_type])
  @@index([status])
}

model AgentRun {
  id                    String    @id @default(cuid())
  template_id           String
  user_id               String
  video_task_id         String?
  video_card_id         String?
  status                String    @default("draft") // draft | planned | submitted | completed | failed
  user_input_json       String
  modifiers_json        String    @default("[]")
  plans_json            String    @default("[]")
  selected_plan_key     String?
  agent_prompt_snapshot String?
  final_prompt_snapshot String?
  user_edited           Boolean   @default(false)
  error_message         String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  completed_at          DateTime?

  template GenerationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  steps    AgentRunStep[]

  @@index([template_id])
  @@index([user_id])
  @@index([video_task_id])
  @@index([video_card_id])
  @@index([status])
  @@index([created_at])
}

model AgentRunStep {
  id           String   @id @default(cuid())
  agent_run_id String
  step_key     String
  title        String
  input_json   String?
  output_json  String?
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())

  agentRun AgentRun @relation(fields: [agent_run_id], references: [id], onDelete: Cascade)

  @@index([agent_run_id])
  @@index([step_key])
  @@index([sort_order])
}

model TemplateMemory {
  id            String   @id @default(cuid())
  template_id   String
  user_id       String?
  agent_run_id  String?
  video_task_id String?
  memory_type   String // plan_selected | prompt_edited | task_result | note
  signal        String // positive | negative | neutral
  summary       String
  metadata_json String?
  created_at    DateTime @default(now())

  template GenerationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@index([user_id])
  @@index([agent_run_id])
  @@index([video_task_id])
  @@index([memory_type])
  @@index([created_at])
}

model UserPreference {
  id         String   @id @default(cuid())
  user_id    String
  key        String
  value_json String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, key])
  @@index([user_id])
  @@index([key])
}

model Project {
  id            String    @id @default(cuid())
  workspace_id  String?
  name          String
  description   String?
  type          String    @default("team") // personal | team | public | system
  visibility    String    @default("private") // private | internal_public | external_public | global_public
  owner_user_id String
  created_by    String
  status        String    @default("active") // active | locked | archived | deleted
  archived_at   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  owner                 User                  @relation("ProjectOwner", fields: [owner_user_id], references: [id])
  creator               User                  @relation("ProjectCreator", fields: [created_by], references: [id])
  members               ProjectMember[]
  invites               ProjectInvite[]
  video_cards           VideoCard[]
  tasks                 VideoTask[]
  canvas_documents      CanvasDocument[]
  reference_albums      ReferenceAlbum[]
  reference_images      ReferenceImage[]
  provider_api_requests ProviderApiRequest[]
  cost_ledgers          CostLedger[]
  cost_allocations      CostAllocation[]
  budget_account        ProjectBudgetAccount?
  budget_ledgers        ProjectBudgetLedger[]
  approval_records      ApprovalRecord[]
  content_audit_logs    ContentAuditLog[]
  feishu_requirements   FeishuRequirement[]
  review_cards          ReviewCard[]
  notifications         Notification[]

  @@index([workspace_id])
  @@index([owner_user_id])
  @@index([created_by])
  @@index([type])
  @@index([visibility])
  @@index([status])
}

model VideoCard {
  id                   String    @id @default(cuid())
  project_id           String
  title                String
  objective            String?
  status               String    @default("active") // draft | active | reviewing | finalized | sealed | merged | archived | discarded
  owner_user_id        String?
  platform             String?
  ratio                String?
  duration             Int?
  target_resolution    String?
  original_ratio       String?
  ratio_locked         Boolean   @default(false)
  ratio_change_reason  String?
  delivery_specs_json  String?
  budget_credits       Float?
  budget_currency      String?   @default("credits")
  current_best_task_id String?
  final_task_id        String?
  is_fallback          Boolean   @default(false)
  merged_into_card_id  String?
  merged_at            DateTime?
  merge_reason         String?
  created_by           String
  sealed_at            DateTime?
  sealed_by            String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  project           Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  owner             User?            @relation("VideoCardOwner", fields: [owner_user_id], references: [id], onDelete: SetNull)
  creator           User             @relation("VideoCardCreator", fields: [created_by], references: [id])
  sealedBy          User?            @relation("VideoCardSealer", fields: [sealed_by], references: [id], onDelete: SetNull)
  tasks             VideoTask[]      @relation("VideoCardTasks")
  current_best_task VideoTask?       @relation("VideoCardCurrentBest", fields: [current_best_task_id], references: [id], onDelete: SetNull)
  final_task        VideoTask?       @relation("VideoCardFinal", fields: [final_task_id], references: [id], onDelete: SetNull)
  approval_records  ApprovalRecord[]
  branches          VideoBranch[]
  notifications     Notification[]

  @@index([project_id])
  @@index([status])
  @@index([owner_user_id])
  @@index([created_by])
  @@index([current_best_task_id])
  @@index([final_task_id])
  @@index([is_fallback])
  @@index([merged_into_card_id])
}

model VideoBranch {
  id                    String    @id @default(cuid())
  video_card_id         String
  title                 String
  description           String?
  status                String    @default("exploring") // exploring | candidate | primary | closed | merged | promoted
  is_primary            Boolean   @default(false)
  promoted_card_id      String?
  merged_into_branch_id String?
  created_by            String
  closed_at             DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  video_card VideoCard   @relation(fields: [video_card_id], references: [id], onDelete: Cascade)
  tasks      VideoTask[]

  @@index([video_card_id])
  @@index([status])
  @@index([is_primary])
  @@index([promoted_card_id])
}

model CanvasDocument {
  id                        String   @id @default(cuid())
  owner_user_id             String
  project_id                String?
  title                     String
  document_json             String
  active_generation_node_id String?
  status                    String   @default("active") // active | archived | deleted
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  owner   User     @relation("CanvasDocumentOwner", fields: [owner_user_id], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([owner_user_id])
  @@index([project_id])
  @@index([status])
  @@index([updated_at])
}

model ProjectMember {
  id         String   @id @default(cuid())
  project_id String
  user_id    String
  role       String   @default("member") // project_owner | editor | member | viewer
  joined_by  String?
  joined_at  DateTime @default(now())
  status     String   @default("active") // active | removed

  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user     User    @relation("ProjectMemberUser", fields: [user_id], references: [id], onDelete: Cascade)
  joinedBy User?   @relation("ProjectMemberJoinedBy", fields: [joined_by], references: [id], onDelete: SetNull)

  @@unique([project_id, user_id])
  @@index([project_id])
  @@index([user_id])
  @@index([role])
  @@index([status])
}

model ProjectInvite {
  id                   String    @id @default(cuid())
  project_id           String
  token                String    @unique
  default_role         String    @default("member")
  allowed_account_type String?
  max_uses             Int?
  used_count           Int       @default(0)
  expires_at           DateTime?
  require_approval     Boolean   @default(false)
  created_by           String
  status               String    @default("active") // active | disabled | expired
  created_at           DateTime  @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  creator User    @relation("ProjectInviteCreatedBy", fields: [created_by], references: [id])

  @@index([project_id])
  @@index([created_by])
  @@index([status])
  @@index([expires_at])
}

model Feedback {
  id              String    @id @default(cuid())
  user_id         String?
  task_id         String?
  content         String
  image_urls_json String?
  page_url        String?
  pathname        String?
  user_agent      String?
  status          String    @default("new") // new | reviewed | archived
  admin_note      String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  archived_at     DateTime?
  archived_by     String?

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@index([pathname])
  @@index([created_at])
}

// 点数账户
model CreditAccount {
  id             String   @id @default(cuid())
  user_id        String   @unique
  balance        Float    @default(0)
  frozen_credits Float    @default(0)
  monthly_used   Float    @default(0)
  total_used     Float    @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// 可过期额度桶。长期点数仍走 CreditAccount.balance；每日配额等临时额度走 bucket。
model CreditBucket {
  id               String    @id @default(cuid())
  user_id          String
  source_type      String // daily_quota
  amount_total     Float
  amount_remaining Float
  frozen_amount    Float     @default(0)
  quota_date       String?
  expires_at       DateTime?
  status           String    @default("active") // active | expired | exhausted | cancelled
  policy_key       String?
  policy_snapshot  String?
  idempotency_key  String?   @unique
  created_by       String?
  metadata_json    String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([source_type])
  @@index([quota_date])
  @@index([status])
  @@index([expires_at])
}

// 点数流水
model CreditLedger {
  id              String   @id @default(cuid())
  user_id         String
  type            String // admin_grant | admin_deduct | system_adjust | task_freeze | task_success_deduct | task_failed_refund | manual_refund | periodic_grant | new_user_initial_grant | daily_quota_grant | daily_quota_expire | expired_refund_closed
  amount          Float
  balance_before  Float
  balance_after   Float
  frozen_before   Float?
  frozen_after    Float?
  related_task_id String?
  operator_id     String?
  reason          String?
  idempotency_key String?
  metadata_json   String?
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([type])
  @@index([created_at])
  @@index([idempotency_key])
}

// 项目预算账户。公共项目从这里冻结、实扣和返还，避免混用个人点数余额。
model ProjectBudgetAccount {
  id                      String   @id @default(cuid())
  project_id              String   @unique
  budget_credits          Float    @default(0)
  used_credits            Float    @default(0)
  frozen_credits          Float    @default(0)
  currency                String   @default("credits")
  status                  String   @default("active") // active | frozen | exhausted | cancelled
  freeze_reason           String?
  reconciliation_status   String   @default("normal") // normal | pending | abnormal | reconciled
  threshold_notified_json String?
  created_by              String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  project Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  ledgers ProjectBudgetLedger[]

  @@index([project_id])
  @@index([status])
}

// 项目预算流水。记录预算追加、任务预占、成功实扣和失败释放。
model ProjectBudgetLedger {
  id              String   @id @default(cuid())
  project_id      String
  account_id      String
  type            String // budget_grant | budget_adjust | task_freeze | task_success_deduct | task_failed_refund | task_freeze_release
  amount          Float
  budget_before   Float
  budget_after    Float
  used_before     Float
  used_after      Float
  frozen_before   Float
  frozen_after    Float
  related_task_id String?
  operator_id     String?
  reason          String?
  idempotency_key String?  @unique
  metadata_json   String?
  created_at      DateTime @default(now())

  project Project              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  account ProjectBudgetAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([account_id])
  @@index([type])
  @@index([related_task_id])
  @@index([operator_id])
  @@index([created_at])
  @@index([idempotency_key])
}

model ApprovalRecord {
  id                     String    @id @default(cuid())
  type                   String // project_create | budget_increase | resolution_1080p | ratio_change | video_card_reopen
  status                 String    @default("pending") // pending | approved | rejected | expired | cancelled
  project_id             String?
  video_card_id          String?
  task_id                String?
  requester_user_id      String
  approver_user_id       String?
  usage_limit            Int?
  used_count             Int       @default(0)
  effect_status          String    @default("pending") // pending | applied | failed | skipped
  effect_error           String?
  reason                 String?
  decision_reason        String?
  scope_json             String?
  requested_payload_json String?
  approved_at            DateTime?
  rejected_at            DateTime?
  expires_at             DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  project       Project?        @relation(fields: [project_id], references: [id], onDelete: SetNull)
  videoCard     VideoCard?      @relation(fields: [video_card_id], references: [id], onDelete: SetNull)
  task          VideoTask?      @relation(fields: [task_id], references: [id], onDelete: SetNull)
  requester     User            @relation("ApprovalRequester", fields: [requester_user_id], references: [id], onDelete: Cascade)
  approver      User?           @relation("ApprovalApprover", fields: [approver_user_id], references: [id], onDelete: SetNull)
  usages        ApprovalUsage[]
  notifications Notification[]

  @@index([type])
  @@index([status])
  @@index([project_id])
  @@index([video_card_id])
  @@index([task_id])
  @@index([requester_user_id])
  @@index([approver_user_id])
  @@index([expires_at])
  @@index([created_at])
}

model ApprovalUsage {
  id            String   @id @default(cuid())
  approval_id   String
  task_id       String?
  user_id       String
  amount        Int      @default(1)
  metadata_json String?
  created_at    DateTime @default(now())

  approval ApprovalRecord @relation(fields: [approval_id], references: [id], onDelete: Cascade)
  task     VideoTask?     @relation(fields: [task_id], references: [id], onDelete: SetNull)
  user     User           @relation("ApprovalUsageUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([approval_id, task_id])
  @@index([approval_id])
  @@index([task_id])
  @@index([user_id])
}

model FeishuRequirement {
  id                 String    @id @default(cuid())
  app_token          String
  table_id           String
  record_id          String
  idempotency_key    String    @unique
  record_type        String    @default("project") // project | video_item
  sync_status        String    @default("draft") // draft | synced | needs_input | failed | confirmed
  raw_fields_json    String
  project_draft_json String?
  video_cards_json   String?
  created_project_id String?
  error_message      String?
  last_synced_at     DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  created_project Project? @relation(fields: [created_project_id], references: [id], onDelete: SetNull)

  @@unique([app_token, table_id, record_id])
  @@index([sync_status])
  @@index([created_project_id])
}

model ReviewCard {
  id                        String   @id @default(cuid())
  project_id                String
  status                    String   @default("draft") // draft | generated | archived
  summary_json              String
  total_credits             Float    @default(0)
  total_amount_micros       Int?
  currency                  String?
  video_card_count          Int      @default(0)
  final_task_count          Int      @default(0)
  failure_rate              Float    @default(0)
  budget_suggestion_credits Float?
  budget_suggestion_reason  String?
  admin_note                String?
  generated_by              String?
  generated_at              DateTime @default(now())
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  project   Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  generator User?   @relation("ReviewCardGenerator", fields: [generated_by], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@index([status])
  @@index([generated_at])
}

model Notification {
  id             String    @id @default(cuid())
  type           String
  channel        String    @default("in_app") // in_app | feishu
  status         String    @default("pending") // pending | sent | read | failed
  target_user_id String
  actor_user_id  String?
  project_id     String?
  video_card_id  String?
  approval_id    String?
  title          String
  body           String?
  metadata_json  String?
  sent_at        DateTime?
  read_at        DateTime?
  error_message  String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  target    User            @relation("NotificationTarget", fields: [target_user_id], references: [id], onDelete: Cascade)
  actor     User?           @relation("NotificationActor", fields: [actor_user_id], references: [id], onDelete: SetNull)
  project   Project?        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  videoCard VideoCard?      @relation(fields: [video_card_id], references: [id], onDelete: SetNull)
