  actor   User?    @relation("ContentAuditActor", fields: [actor_user_id], references: [id], onDelete: SetNull)
  owner   User?    @relation("ContentAuditOwner", fields: [owner_user_id], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

