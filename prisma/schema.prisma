  @@index([target_type, target_id])
  @@index([created_at])
}

model ContentAuditLog {
  id            String   @id @default(cuid())
  actor_user_id String?
  action        String
  content_type  String
  content_id    String
  owner_user_id String?
  project_id    String?
  detail_json   String?
